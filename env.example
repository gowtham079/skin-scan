# Environment Variables for Skin Scan Application
# For local development: Copy this file to .env and fill in your actual values.
# For Render deployment: Add these variables under "Environment" in your Render Dashboard.

# Flask Configuration
FLASK_APP=app.py
FLASK_ENV=production
# Generate a secure key (e.g., using: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=change-this-to-a-random-secret-key-in-production

# Database Configuration
# Leave unset or use sqlite:///skin_scan.db for default SQLite
# Or provide a Render PostgreSQL internal/external connection URL
# DATABASE_URL=postgresql://user:password@hostname/dbname

# Email Configuration (Optional - for welcome emails & report emails)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USE_SSL=False
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=

# Runtime settings
PORT=5000
DEBUG=False
